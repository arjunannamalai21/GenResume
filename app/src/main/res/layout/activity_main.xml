<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Your Resume"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:inputType="phone"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etLinkedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="LinkedIn Profile URL (Optional)"
            android:inputType="textUri"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summary / Professional Objective"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"/>

        <EditText
            android:id="@+id/etSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E.g., Experienced software developer looking for new challenges..."
            android:inputType="textMultiLine"
            android:lines="4"
            android:gravity="top|start"
            android:minHeight="96dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Education (Add one at a time, or list comma-separated)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"/>

        <EditText
            android:id="@+id/etEducation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E.g., B.Tech in CSE, University Name, Year"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top|start"
            android:minHeight="72dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Work Experience (List roles, companies, dates, and responsibilities)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"/>

        <EditText
            android:id="@+id/etExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E.g., Software Engineer, ABC Corp (2020-Present): Developed X, Managed Y, Achieved Z..."
            android:inputType="textMultiLine"
            android:lines="6"
            android:gravity="top|start"
            android:minHeight="144dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skills (Comma-separated)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"/>

        <EditText
            android:id="@+id/id_etSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E.g., Java, Android, Python, SQL, Git"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top|start"
            android:minHeight="72dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Projects (Optional: Name, Description, Technologies)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"/>

        <EditText
            android:id="@+id/etProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E.g., My Portfolio App: Developed an Android app using Kotlin and Room DB..."
            android:inputType="textMultiLine"
            android:lines="4"
            android:gravity="top|start"
            android:minHeight="96dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Certifications (Optional: Name, Issuing Body, Date)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"/>

        <EditText
            android:id="@+id/etCertifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E.g., AWS Certified Developer, Amazon Web Services, 2023"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top|start"
            android:minHeight="72dp" />

        <Button
            android:id="@+id/btnGenerateResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Resume"
            android:layout_marginTop="30dp"
            android:padding="12dp"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>